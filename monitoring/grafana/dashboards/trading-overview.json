      "id": 2,
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "pluginVersion": "8.0.0",
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{uri!=\"UNKNOWN\",method=\"POST\"}[1m]) * 60",
          "legendFormat": "Orders/min - {{uri}}",
          "refId": "A"
        },
        {
          "expr": "rate(matching_attempt_total[1m]) * 60",
          "legendFormat": "Match Attempts/min",
          "refId": "B"
        },
        {
          "expr": "rate(matching_success_total[1m]) * 60",
          "legendFormat": "Successful Matches/min",
          "refId": "C"
        },
        {
          "expr": "rate(matching_trade_executed_total[1m]) * 60",
          "legendFormat": "Trades Executed/min",
          "refId": "D"
        }
      ],
      "title": "Trading Activity",
      "type": "timeseries"
    },
